<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <!-- @MARKER@ -->
    <key>Label</key>
    <string>@NAME@</string>
    <key>ProgramArguments</key>
    <array>
      <string>@BINARY@</string>
      <string>run</string>
      <string>@OWNER@</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>2</integer>
    <key>Umask</key>
    <integer>63</integer>
  </dict>
</plist>
