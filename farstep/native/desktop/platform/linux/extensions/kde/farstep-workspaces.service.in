[Unit]
Description=Farstep KDE workspace broker
PartOf=graphical-session.target
After=graphical-session.target
ConditionEnvironment=XDG_CURRENT_DESKTOP=KDE

[Service]
Type=dbus
BusName=org.farstep.Workspaces
ExecStart=@GJS@ -m @BROKER@
Restart=on-failure
RestartSec=1

[Install]
WantedBy=graphical-session.target
