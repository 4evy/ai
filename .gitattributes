# Normalize detected text to LF, including scripts
* text=auto eol=lf

# Windows batch launchers use CRLF on checkout
*.bat text eol=crlf
*.cmd text eol=crlf

# Patches must preserve the line endings of the files they modify
*.patch -text
*.diff -text

# Keep binary assets and packaged payloads out of text conversion and merging
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.icns binary
*.pdf binary
*.wasm binary
*.zip binary
*.tar binary
*.gz binary
*.tgz binary
*.bz2 binary
*.xz binary
*.zst binary
*.dmg binary
*.msix binary
*.exe binary
*.dll binary
*.so binary
*.dylib binary
*.node binary

# Dependency lock files at any depth; runtime locks are not generated source
bun.lock linguist-generated=true
bun.lockb linguist-generated=true
Cargo.lock linguist-generated=true
flake.lock linguist-generated=true
package-lock.json linguist-generated=true
npm-shrinkwrap.json linguist-generated=true
pnpm-lock.yaml linguist-generated=true
pnpm-lock.yml linguist-generated=true

# Dependency expressions generated by bun2nix
bun.nix linguist-generated=true

# Copied upstream dependencies
farstep/sky/upstream/** linguist-vendored=true
apps/omp/runtime/upstream/** linguist-vendored=true
