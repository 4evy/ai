{
  "name": "ai-tools",
  "dependencies": {
    "@optique/core": "1.3.6",
    "@nodelib/fs.walk": "3.0.1",
    "@optique/valibot": "1.3.6",
    "valibot": "1.5.0",
    "vscode-jsonrpc": "10.0.0",
    "effect": "4.0.6",
    "@ai/values": "workspace:*",
    "@ai/runtime": "workspace:*",
    "@ai/toolkit": "workspace:*",
    "diff": "9.0.0",
    "atomically": "2.1.1",
    "@oh-my-pi/pi-utils": "18.13.1"
  },
  "devDependencies": {
    "@actions/core": "3.0.1",
    "@actions/exec": "3.0.0",
    "@biomejs/biome": "2.6.2",
    "@types/bun": "catalog:",
    "farstep": "workspace:*",
    "knip": "6.42.1",
    "omp-agent-runtime": "workspace:*",
    "typescript": "catalog:",
    "vite": "catalog:"
  },
  "patchedDependencies": {
    "@oh-my-pi/pi-coding-agent@18.13.1": "apps/omp/runtime/npm/agent/agent.patch",
    "@oh-my-pi/pi-tui@18.13.1": "apps/omp/runtime/npm/tui/tui.patch"
  },
  "private": true,
  "packageManager": "bun@1.4.4",
  "workspaces": {
    "packages": [
      "packages/values",
      "packages/runtime",
      "packages/toolkit",
      "apps/chatgpt",
      "apps/omp",
      "farstep"
    ],
    "catalog": {
      "@types/bun": "1.4.4",
      "typescript": "7.0.2",
      "vite": "8.3.5"
    }
  },
  "scripts": {
    "farstep:tools": "bun farstep/integration/cli.ts",
    "test": "bun test ./packages/runtime",
    "check": "bun run check:biome && bun run check:github && bun run check:rust && bun run check:sky && bun run check:patches && bun run typecheck && bun run test && bun run check:dependencies && bun run check:architecture && bun run build",
    "check:biome": "bun x --no-install biome check .",
    "check:github": "bun .github/scripts/check/check.ts",
    "check:rust": "bun tools/scripts/rust/rust.ts",
    "check:sky": "bun tools/scripts/sky/sky.ts --check-local",
    "check:patches": "bun tools/scripts/omp/patches/patches.ts --check",
    "check:powershell": "pwsh -NoProfile -File tools/scripts/powershell/powershell.ps1 -Check",
    "format": "nix fmt --",
    "format:powershell": "nix fmt -- --formatters powershell",
    "typecheck": "bun x --no-install tsc -p tsconfig.json && bun run --sequential --workspaces typecheck",
    "sky:sync": "bun tools/scripts/sky/sky.ts",
    "sky:check": "bun tools/scripts/sky/sky.ts --check",
    "sky:update": "bun tools/scripts/sky/update.ts",
    "sky:verify": "bun tools/scripts/sky/update.ts --check",
    "check:dependencies": "bun x --no-install knip --include dependencies,unlisted,unresolved",
    "dependencies:report": "bun x --no-install knip --no-exit-code",
    "check:architecture": "bun x --no-install tsc -p tools/scripts/dependencies/tsconfig.json && bun tools/scripts/dependencies/check.ts packages/values packages/runtime packages/toolkit farstep apps/codex apps/claude apps/chatgpt apps/omp/lib apps/omp/extensions",
    "build": "bun run build:root && bun run --sequential --workspaces build",
    "build:root": "bun --bun x --no-install vite build",
    "build:report": "bun tools/scripts/vite/report.ts"
  },
  "type": "module"
}
