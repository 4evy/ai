{
  "name": "@ai/core",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./core.ts",
    "./*": "./*.ts"
  },
  "imports": {
    "#core/*": "./*.ts"
  },
  "scripts": {
    "typecheck": "bun x --no-install tsc -p tsconfig.json",
    "build": "bun --bun x --no-install vite build"
  },
  "dependencies": {
    "valibot": "1.5.0",
    "effect": "4.0.6",
    "@effect/opentelemetry": "4.0.5",
    "@logtape/file": "2.4.2",
    "@logtape/logtape": "2.4.2",
    "@logtape/redaction": "2.4.2",
    "@opentelemetry/core": "2.12.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.223.0",
    "@opentelemetry/resources": "2.12.0",
    "@opentelemetry/sdk-trace-base": "2.12.0",
    "@valibot/to-json-schema": "1.8.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "mdast-util-from-markdown": "2.1.0"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:"
  }
}
