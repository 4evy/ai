{
  "name": "omp-agent-runtime",
  "version": "1.0.0",
  "exports": {
    "./lib/*": "./lib/*.ts",
    "./extensions/*": "./extensions/*.ts",
    "./runtime/*": "./runtime/*.ts"
  },
  "imports": {
    "#apps/omp/*": "./*.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "@oh-my-pi/pi-utils": "18.13.1",
    "@tailnet/tailscaled": "0.1.2",
    "valibot": "1.5.0",
    "effect": "4.0.6",
    "@ai/core": "workspace:*",
    "farstep": "workspace:*",
    "ipaddr.js": "2.5.0"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:"
  },
  "peerDependencies": {
    "@oh-my-pi/pi-agent-core": "18.13.1",
    "@oh-my-pi/pi-coding-agent": "18.13.1",
    "@oh-my-pi/pi-tui": "18.13.1"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "bun x --no-install tsc -p tsconfig.json",
    "build": "bun --bun x --no-install vite build"
  }
}
