#!/bin/sh
set -eu

repo=${AI_TOOLS_REPO:-}
if [ -z "$repo" ]; then
  script=$0
  while [ -L "$script" ]; do
    link=$(readlink "$script")
    case "$link" in
    /*) script=$link ;;
    *) script=$(dirname "$script")/$link ;;
    esac
  done
  repo=$(CDPATH='' cd -- "$(dirname -- "$script")/../.." && pwd)
fi

# Check update policy before starting the pinned Nix runtime
. "$repo/apps/omp/runtime/policy/policy.sh"

export AI_TOOLS_REPO="$repo"
exec nix shell "path:$repo#ai-tools" --command omp "$@"
