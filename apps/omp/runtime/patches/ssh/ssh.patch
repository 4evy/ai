+function identityControlPath(host: SSHConnectionTarget): string {
+	if (!host.keyPath) return CONTROL_PATH;
+	// OpenSSH's %C excludes IdentityFile, so explicit keys need isolated masters
+	const digest = new Bun.CryptoHasher("sha256")
+		.update(JSON.stringify([host.host, host.username ?? null, host.port ?? null, host.keyPath]))
+		.digest("hex");
+	return path.join(CONTROL_DIR, `k-${digest.slice(0, 32)}.sock`);
+}
+
 /**
  * Who owns the ControlPath socket for a host: omp's private control directory,
  * or the user's ssh_config (see {@link resolveControlPathOwner}).
@@ -196,7 +205,7 @@
 	if (supportsSshControlMaster(options?.platform)) {
 		args.push("-o", "ControlMaster=auto");
 		// A config-owned socket keeps the user's ControlPath and ControlPersist.
-		if (owner === "omp") args.push("-o", `ControlPath=${CONTROL_PATH}`, "-o", "ControlPersist=3600");
+		if (owner === "omp") args.push("-o", `ControlPath=${identityControlPath(host)}`, "-o", "ControlPersist=3600");
 	}
 
 	args.push("-o", "BatchMode=yes", "-o", "StrictHostKeyChecking=accept-new");
