+	/** Copy viewed-agent prose without reasoning or tool output */
+	async #copyAgentResponse(): Promise<void> {
+		const messages = this.ctx.viewSession.messages;
+		for (let index = messages.length - 1; index >= 0; index--) {
+			const message = messages[index]!;
+			if (message.role !== "assistant") continue;
+			const text = this.ctx.extractAssistantText(message);
+			if (!text) continue;
+			try {
+				await copyToClipboard(text);
+				this.ctx.showStatus("Copied agent response to clipboard");
+			} catch {
+				this.ctx.showWarning("Failed to copy agent response to clipboard");
+			}
+			return;
+		}
+		this.ctx.showStatus("No agent response to copy");
+	}
