+	/** Text-host `/goal` operations share the structured RPC controller's lifecycle */
+	async handleSlashCommand(args: string): Promise<string> {
+		const help = "Usage: /goal [objective|set <objective>|show|pause|resume|drop|budget <N|off>]";
+		const trimmed = args.trim();
+		const match = /^(\S+)(?:\s+([\s\S]*))?$/.exec(trimmed);
+		const action = match?.[1].toLowerCase();
+		const rest = match?.[2]?.trim() ?? "";
+		await this.settled();
+		if (!action) return `${this.#describeGoal()}\n\n${help}`;
+		if (["show", "pause", "resume", "drop"].includes(action) && rest) {
+			throw new Error(`Usage: /goal ${action}`);
+		}
+		switch (action) {
+			case "show":
+				break;
+			case "pause":
+				if (!this.#session.getGoalModeState()?.enabled) throw new Error("No active goal to pause.");
+				await this.handle({ op: "pause" });
+				break;
+			case "resume":
+				await this.handle({ op: "resume" });
+				break;
+			case "drop":
+				if (!this.#session.getGoalModeState()?.goal) return "No goal set.";
+				await this.handle({ op: "drop" });
+				return "Goal dropped. No goal set.";
+			case "budget": {
+				this.#assertCanEnter();
+				const state = this.#session.getGoalModeState();
+				if (!state?.enabled || (state.goal.status !== "active" && state.goal.status !== "budget-limited")) {
+					throw new Error(
+						state?.goal.status === "paused" ? "Resume the goal before adjusting the budget." : "No active goal.",
+					);
+				}
+				let budget: number | undefined;
+				if (rest.toLowerCase() !== "off") {
+					budget = /^\d+$/.test(rest) ? Number(rest) : NaN;
+					if (!Number.isSafeInteger(budget) || budget <= 0) {
+						throw new Error("Usage: /goal budget <positive integer|off>");
+					}
+				}
+				await this.#session.goalRuntime.onBudgetMutated(budget);
+				this.#resetContinuation();
+				this.#scheduleContinuation();
+				break;
+			}
+			case "set":
+				if (!rest) throw new Error("Usage: /goal set <objective>");
+				this.#assertCanEnter();
+				if (this.#session.getGoalModeState()?.enabled) {
+					await this.#enter(() => this.#session.goalRuntime.replaceGoal({ objective: rest }));
+				} else {
+					await this.handle({ op: "create", objective: rest });
+				}
+				break;
+			default:
+				await this.handle({ op: "create", objective: trimmed });
+		}
+		return this.#describeGoal();
+	}
+
+	#describeGoal(): string {
+		const goal = this.#session.getGoalModeState()?.goal;
+		if (!goal) return "No goal set.";
+		const budget =
+			goal.tokenBudget === undefined
+				? `${goal.tokensUsed} used (no budget)`
+				: `${goal.tokensUsed} / ${goal.tokenBudget} (${Math.max(0, goal.tokenBudget - goal.tokensUsed)} left)`;
+		return [
+			`Objective: ${goal.objective}`,
+			`Status: ${goal.status}`,
+			`Tokens: ${budget}`,
+			`Time spent: ${goal.timeUsedSeconds} seconds`,
+		].join("\n");
+	}
+
 	#assertCanEnter(): void {
 		if (!cfgGoalEnabled.get(this.#session.settings)) {
 			throw new Error("Goal mode is disabled (goal.enabled).");
